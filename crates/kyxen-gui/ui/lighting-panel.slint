// Right-hand panel of the lighting tab.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ui, Thumb } from "state.slint";
import { Button, ButtonKind, Chip, Divider, Label, SectionTitle, Slider } from "widgets.slint";
import { ColorPicker } from "colorpicker.slint";

component EffectCard inherits Rectangle {
    in property <string> label;
    in property <Thumb> thumb;
    in property <bool> selected;
    callback clicked;
    height: 88px;
    border-radius: Theme.radius;
    background: selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.raised;
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    animate background, border-color { duration: 140ms; }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            border-radius: 7px;
            background: #0c0e12;
            clip: true;
            HorizontalLayout {
                padding: 5px;
                spacing: 2px;
                for c in thumb.colors: Rectangle {
                    border-radius: 2px;
                    background: c;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: c.with-alpha(0.6);
                }
            }
        }
        Text {
            text: label;
            font-family: Theme.font;
            font-size: Theme.font-sm;
            font-weight: selected ? 700 : 500;
            color: selected ? Theme.text : Theme.text-dim;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LightingPanel inherits ScrollView {
    property <[string]> names: ["Statisch", "Atmen", "Welle", "Regenbogen", "Farbwechsel", "Animation"];

    VerticalLayout {
        alignment: start;
        padding: 24px;
        spacing: 18px;

        Text {
            text: "Effekt";
            font-family: Theme.font;
            font-size: Theme.font-xl;
            font-weight: 700;
            color: Theme.text;
        }

        GridLayout {
            spacing: 10px;
            Row {
                for i in [0, 1]: EffectCard {
                    label: names[i];
                    thumb: Ui.thumbs[i];
                    selected: Ui.l-effect == i;
                    clicked => { Ui.set-effect(i); }
                }
            }
            Row {
                for i in [2, 3]: EffectCard {
                    label: names[i];
                    thumb: Ui.thumbs[i];
                    selected: Ui.l-effect == i;
                    clicked => { Ui.set-effect(i); }
                }
            }
            Row {
                for i in [4, 5]: EffectCard {
                    label: names[i];
                    thumb: Ui.thumbs[i];
                    selected: Ui.l-effect == i;
                    clicked => { Ui.set-effect(i); }
                }
            }
        }

        Divider { }

        if Ui.l-effect == 0: VerticalLayout {
            spacing: 14px;
            SectionTitle {
                text: "PINSELFARBE";
            }
            ColorPicker { }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    horizontal-stretch: 1;
                    kind: ButtonKind.secondary;
                    has-icon: true;
                    icon: @image-url("icons/fill.svg");
                    text: "Alle Tasten";
                    font-size: Theme.font-sm;
                    clicked => { Ui.fill-all(); }
                }
                Button {
                    horizontal-stretch: 1;
                    kind: ButtonKind.ghost;
                    has-icon: true;
                    icon: @image-url("icons/eraser.svg");
                    text: "Bemalung löschen";
                    font-size: Theme.font-sm;
                    clicked => { Ui.clear-paint(); }
                }
            }
            Label {
                text: "Klick oder zieh über Tasten, um sie mit der Pinselfarbe zu bemalen.";
                wrap: word-wrap;
            }
        }

        if Ui.l-effect == 1 || Ui.l-effect == 2: VerticalLayout {
            spacing: 14px;
            SectionTitle {
                text: Ui.l-effect == 1 ? "FARBE" : "FARBEN";
            }
            if Ui.l-stops.length > 1: HorizontalLayout {
                spacing: 8px;
                for c[i] in Ui.l-stops: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    background: Ui.l-stop == i ? Theme.accent-soft : Theme.raised;
                    border-width: 1px;
                    border-color: Ui.l-stop == i ? Theme.accent : Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: c;
                        }
                        Text {
                            text: i == 0 ? "Farbe 1" : "Farbe 2";
                            font-family: Theme.font;
                            font-size: Theme.font-sm;
                            color: Ui.l-stop == i ? Theme.text : Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Ui.select-stop(i); }
                    }
                }
            }
            ColorPicker { }
        }

        if Ui.l-effect == 3 || Ui.l-effect == 4: Label {
            text: Ui.l-effect == 3
                ? "Der Regenbogen läuft durch alle Farben."
                : "Alle Tasten wechseln gemeinsam durch das Farbspektrum.";
            wrap: word-wrap;
        }

        if Ui.l-effect == 5: Label {
            text: "Animationen mit eigenen Folien kommen mit dem Folien-Editor. Bis dahin läuft eine Beispiel-Animation.";
            wrap: word-wrap;
        }

        if Ui.l-effect >= 1 && Ui.l-effect <= 4: Slider {
            label: "Geschwindigkeit";
            display: Ui.l-speed-text;
            value: Ui.l-speed;
            changed(v) => { Ui.set-speed(v); }
        }

        if Ui.l-effect == 2 || Ui.l-effect == 3: VerticalLayout {
            spacing: 10px;
            Text {
                text: "Richtung";
                font-family: Theme.font;
                font-size: Theme.font-md;
                font-weight: 600;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: 6px;
                for d[i] in [
                    @image-url("icons/arrow-right.svg"),
                    @image-url("icons/arrow-left.svg"),
                    @image-url("icons/arrow-down.svg"),
                    @image-url("icons/arrow-up.svg"),
                    @image-url("icons/radial.svg"),
                ]: Chip {
                    horizontal-stretch: 1;
                    has-icon: true;
                    icon: d;
                    selected: Ui.l-direction == i;
                    clicked => { Ui.set-direction(i); }
                }
            }
        }

        Slider {
            label: "Helligkeit";
            display: Math.round(Ui.l-brightness * 100) + " %";
            value: Ui.l-brightness;
            changed(v) => { Ui.set-brightness(v); }
        }
    }
}

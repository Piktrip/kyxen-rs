// Design tokens. Dark graphite surfaces, one electric-green accent.

export global Theme {
    // surfaces, back to front
    out property <color> bg: #0b0d11;
    out property <color> surface: #101318;
    out property <color> panel: #151920;
    out property <color> raised: #1b2029;
    out property <color> hover: #222833;
    out property <color> pressed: #2a313d;

    // lines
    out property <color> border: #232934;
    out property <color> border-strong: #323a48;

    // text
    out property <color> text: #e9ecf2;
    out property <color> text-dim: #a1a9b7;
    out property <color> text-faint: #646d7c;

    // accent + signals
    out property <color> accent: #3ddc84;
    out property <color> accent-soft: #3ddc8424;
    out property <color> accent-line: #3ddc8466;
    out property <color> on-accent: #06210f;
    out property <color> danger: #ff5f5f;
    out property <color> danger-soft: #ff5f5f22;

    out property <length> radius-lg: 16px;
    out property <length> radius: 12px;
    out property <length> radius-sm: 8px;

    out property <length> gap: 12px;
    out property <length> pad: 20px;

    out property <string> font: "Noto Sans";
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12.5px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 17px;
    out property <length> font-xl: 24px;
}

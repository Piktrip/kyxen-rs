// Right-hand inspector for the selected G-key.

import { TextEdit, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ui } from "state.slint";
import { Button, ButtonKind, ChoiceTile, Chip, KeyChip, Label, SectionTitle, Slider, Toggle, Divider, Icon } from "widgets.slint";

export global Kinds {
    out property <[string]> names: [@tr("None"), @tr("Text"), @tr("Combo"), @tr("Command"), @tr("Hold"), @tr("Mouse")];
    out property <[image]> icons: [
        @image-url("icons/none.svg"),
        @image-url("icons/text.svg"),
        @image-url("icons/combo.svg"),
        @image-url("icons/terminal.svg"),
        @image-url("icons/hold.svg"),
        @image-url("icons/mouse.svg"),
    ];
}

export component MacroPanel inherits VerticalLayout {
    padding: 24px;
    spacing: 18px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: "G" + Ui.sel-gkey;
            font-family: Theme.font;
            font-size: Theme.font-xl;
            font-weight: 800;
            color: Theme.accent;
        }
        Text {
            text: @tr("·  Macro");
            font-family: Theme.font;
            font-size: Theme.font-xl;
            font-weight: 700;
            color: Theme.text;
        }
    }

    SectionTitle {
        text: @tr("ACTION");
    }

    GridLayout {
        spacing: 8px;
        Row {
            for i in [0, 1, 2]: ChoiceTile {
                icon: Kinds.icons[i];
                label: Kinds.names[i];
                selected: Ui.m-kind == i;
                clicked => { Ui.set-kind(i); }
            }
        }
        Row {
            for i in [3, 4, 5]: ChoiceTile {
                icon: Kinds.icons[i];
                label: Kinds.names[i];
                selected: Ui.m-kind == i;
                clicked => { Ui.set-kind(i); }
            }
        }
    }

    Divider { }

    // ── details per action ──────────────────────────────────────────────
    if Ui.m-kind == 0: Label {
        text: @tr("This G-key does nothing. Pick an action above.");
        wrap: word-wrap;
    }

    if Ui.m-kind == 1: VerticalLayout {
        spacing: 10px;
        SectionTitle {
            text: @tr("TEXT");
        }
        TextEdit {
            height: 120px;
            font-size: Theme.font-md;
            text <=> Ui.m-text;
            edited(t) => { Ui.set-text(t); }
        }
        Label {
            text: @tr("Typed with your keyboard layout ({}), including umlauts, @ and €.", Ui.layout-name);
            wrap: word-wrap;
        }
    }

    if Ui.m-kind == 2 || Ui.m-kind == 4: VerticalLayout {
        spacing: 14px;
        SectionTitle {
            text: Ui.m-kind == 2 ? @tr("KEY COMBO") : @tr("HELD KEYS");
        }
        Rectangle {
            min-height: 84px;
            border-radius: Theme.radius;
            background: Ui.recording ? #ff5f5f10 : Theme.surface;
            border-width: 1px;
            border-color: Ui.recording ? #ff5f5f80 : Theme.border;
            animate background, border-color { duration: 160ms; }
            if Ui.m-keys.length == 0: Text {
                text: Ui.recording ? @tr("Press the keys now …") : @tr("No keys yet");
                font-family: Theme.font;
                font-size: Theme.font-md;
                color: Ui.recording ? Theme.danger : Theme.text-faint;
            }
            if Ui.m-keys.length > 0: HorizontalLayout {
                alignment: center;
                spacing: 10px;
                padding: 14px;
                for k[i] in Ui.m-keys: HorizontalLayout {
                    spacing: 10px;
                    if i > 0: Text {
                        text: "+";
                        font-family: Theme.font;
                        font-size: Theme.font-lg;
                        color: Theme.text-faint;
                        vertical-alignment: center;
                    }
                    KeyChip {
                        text: k;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Button {
                horizontal-stretch: 1;
                kind: ButtonKind.record;
                has-icon: true;
                icon: @image-url("icons/record.svg");
                text: Ui.recording ? @tr("Recording – Esc cancels") : @tr("Record");
                clicked => { Ui.start-record(); }
            }
            if Ui.m-keys.length > 0 && !Ui.recording: Button {
                kind: ButtonKind.ghost;
                has-icon: true;
                icon: @image-url("icons/x.svg");
                clicked => { Ui.clear-keys(); }
            }
        }
        if Ui.m-kind == 4: Label {
            text: @tr("The first press of the G-key holds the keys, the second press releases them.");
            wrap: word-wrap;
        }
    }

    if Ui.m-kind == 3: VerticalLayout {
        spacing: 10px;
        SectionTitle {
            text: @tr("COMMAND");
        }
        LineEdit {
            font-size: Theme.font-md;
            placeholder-text: @tr("e.g. notify-send Hello");
            text <=> Ui.m-cmd;
            edited(t) => { Ui.set-cmd(t); }
        }
        Label {
            text: @tr("Runs in the background through the shell, like in a terminal.");
            wrap: word-wrap;
        }
    }

    if Ui.m-kind == 5: VerticalLayout {
        spacing: 12px;
        SectionTitle {
            text: @tr("MOUSE BUTTON");
        }
        HorizontalLayout {
            spacing: 6px;
            for b[i] in [@tr("Left"), @tr("Right"), @tr("Middle"), "4", "5"]: Chip {
                horizontal-stretch: 1;
                text: b;
                selected: Ui.m-mouse-btn == i;
                clicked => { Ui.set-mouse(i, Ui.m-mouse-mode); }
            }
        }
        SectionTitle {
            text: @tr("BEHAVIOR");
        }
        HorizontalLayout {
            spacing: 6px;
            for m[i] in [@tr("Click"), @tr("Double-click"), @tr("Hold")]: Chip {
                horizontal-stretch: 1;
                text: m;
                selected: Ui.m-mouse-mode == i;
                clicked => { Ui.set-mouse(Ui.m-mouse-btn, i); }
            }
        }
    }

    if Ui.m-kind != 0 && Ui.m-kind != 4 && !(Ui.m-kind == 5 && Ui.m-mouse-mode == 2): VerticalLayout {
        spacing: 14px;
        Divider { }
        HorizontalLayout {
            spacing: 12px;
            Icon {
                source: @image-url("icons/repeat.svg");
                tint: Ui.m-repeat ? Theme.accent : Theme.text-dim;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: @tr("Repeat while held");
                font-family: Theme.font;
                font-size: Theme.font-md;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: Ui.m-repeat;
                toggled(on) => { Ui.set-repeat(on); }
            }
        }
        if Ui.m-repeat: Slider {
            label: @tr("Interval");
            display: Ui.m-rate-text;
            value: Ui.m-rate;
            changed(v) => { Ui.set-rate(v); }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }

    Button {
        has-icon: true;
        icon: @image-url("icons/play.svg");
        text: Ui.connected ? @tr("Test") : @tr("Test (daemon not running)");
        enabled: Ui.connected && Ui.m-kind != 0;
        clicked => { Ui.test-macro(); }
    }
}

import { LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Ui } from "state.slint";
import { Tr } from "tr.slint";
import { Button, ButtonKind, Card, Chip, Label, SectionTitle, Toggle } from "widgets.slint";

component Row inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 24px;
    VerticalLayout {
        width: 220px;
        alignment: center;
        spacing: 3px;
        Text {
            text: title;
            font-family: Theme.font;
            font-size: Theme.font-md;
            font-weight: 600;
            color: Theme.text;
        }
        if hint != "": Text {
            text: hint;
            font-family: Theme.font;
            font-size: Theme.font-sm;
            color: Theme.text-faint;
            wrap: word-wrap;
        }
    }
    @children
}

export component SettingsPage inherits ScrollView {
    HorizontalLayout {
    alignment: start;
    padding-bottom: 8px;
    VerticalLayout {
        max-width: 760px;
        horizontal-stretch: 1;
        spacing: 18px;
        alignment: start;

        Card {
            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                SectionTitle {
                    text: @tr("PROFILE");
                }
                Row {
                    title: @tr("Name");
                    LineEdit {
                        font-size: Theme.font-md;
                        text <=> Ui.p-name;
                        edited(t) => { Ui.rename(t); }
                    }
                }
                Row {
                    title: @tr("Color");
                    hint: @tr("Marker color in the list");
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for c in Ui.palette: Rectangle {
                            width: 30px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 15px;
                            background: c;
                            border-width: Ui.profiles[Ui.current-profile].color == c ? 3px : (sw.has-hover ? 2px : 0px);
                            border-color: #ffffff;
                            sw := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Ui.set-profile-color(c); }
                            }
                        }
                    }
                }
                Row {
                    title: @tr("M-key");
                    hint: @tr("Key on the keyboard that activates this profile");
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for s[i] in [@tr("None"), "M1", "M2", "M3"]: Chip {
                            width: 76px;
                            text: s;
                            selected: Ui.p-slot == i;
                            clicked => { Ui.set-slot(i); }
                        }
                    }
                }
                Row {
                    title: @tr("Delete profile");
                    hint: @tr("Removes the profile file");
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            kind: ButtonKind.danger;
                            has-icon: true;
                            icon: @image-url("icons/trash.svg");
                            text: @tr("Delete");
                            enabled: Ui.profiles.length > 1;
                            clicked => { Ui.delete-profile(); }
                        }
                    }
                }
            }
        }

        Card {
            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                SectionTitle {
                    text: @tr("KEYBOARD");
                }
                Row {
                    title: @tr("Layout for text macros");
                    hint: @tr("Automatic = system setting");
                    ComboBox {
                        model: Tr.layouts;
                        current-index: Ui.layout-choice;
                        selected => { Ui.set-layout(self.current-index); }
                    }
                }
                Row {
                    title: @tr("Key shape");
                    hint: @tr("ISO: tall Enter, <> key (DE, AT, UK) · ANSI: wide Enter (US)");
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for s[i] in [@tr("Automatic"), "ISO", "ANSI"]: Chip {
                            width: 104px;
                            text: s;
                            selected: Ui.form-choice == i;
                            clicked => { Ui.set-form(i); }
                        }
                    }
                }
                Row {
                    title: @tr("Device");
                    Label {
                        text: Ui.connected
                            ? (Ui.keyboard-name != "" ? Ui.keyboard-name : @tr("Daemon running, no keyboard"))
                            : @tr("Daemon not running – start kyxend");
                        font-size: Theme.font-md;
                        color: Ui.connected ? Theme.text : Theme.danger;
                    }
                }
            }
        }

        Card {
            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                SectionTitle {
                    text: @tr("APP");
                }
                Row {
                    title: @tr("Language");
                    hint: @tr("Automatic = system language");
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        // language names stay in their own language
                        for s[i] in [@tr("Automatic"), "Deutsch", "English"]: Chip {
                            width: 104px;
                            text: s;
                            selected: Ui.language-choice == i;
                            clicked => { Ui.set-language(i); }
                        }
                    }
                }
                Row {
                    title: @tr("Tray icon");
                    hint: @tr("Kyxen stays in the system tray when you close the window");
                    HorizontalLayout {
                        alignment: start;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: Ui.tray-enabled;
                            toggled(on) => { Ui.set-tray(on); }
                        }
                    }
                }
                if Ui.tray-enabled: Row {
                    title: @tr("Start at login");
                    hint: @tr("Tray icon right after you log in");
                    HorizontalLayout {
                        alignment: start;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: Ui.tray-autostart;
                            toggled(on) => { Ui.set-autostart(on); }
                        }
                    }
                }
            }
        }

        Card {
            VerticalLayout {
                padding: 24px;
                spacing: 8px;
                SectionTitle {
                    text: @tr("ABOUT");
                }
                Label {
                    text: @tr("kyxen {} · GPL-3.0 · based on Kyxen by Wade Quinn", Ui.version);
                    font-size: Theme.font-md;
                }
            }
        }
    }
}
}
